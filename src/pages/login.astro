---
import { SESSION_COOKIE, createSessionToken, sessionCookieOptions, signIn } from '../lib/auth';
import { clientIp, userAgent } from '../lib/request';
import { recordLogin } from '../lib/users';
import '../styles/dashboard.css';

export const prerender = false;

/** Only same-site paths, so a crafted `next` cannot bounce anyone off-site. */
const safeNext = (value: string | null) =>
  value && value.startsWith('/') && !value.startsWith('//') ? value : '/';

let error: string | null = null;
let next = safeNext(Astro.url.searchParams.get('next'));
let username = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  username = String(form.get('username') ?? '').trim();
  const password = String(form.get('password') ?? '');
  next = safeNext(String(form.get('next') ?? ''));

  const user = signIn(username, password);

  // Every attempt is logged, successful or not — a run of failures against a
  // real username is the thing the admin most needs to see.
  recordLogin({
    userId: user?.id ?? null,
    // The account's own spelling on success, so one account is one name in the
    // log however it was typed; the typed text on failure, since that is the
    // evidence of what was actually tried.
    username: user?.username ?? (username || '(blank)'),
    ok: Boolean(user),
    ip: clientIp(Astro),
    userAgent: userAgent(Astro),
    note: user ? null : 'wrong username or password',
  });

  if (user) {
    Astro.cookies.set(SESSION_COOKIE, createSessionToken(user), sessionCookieOptions(Astro.url));
    return Astro.redirect(next, 303);
  }
  error = 'Wrong username or password.';
}

// Already signed in and visiting /login directly: nothing to do here.
if (Astro.request.method === 'GET' && Astro.locals.user) return Astro.redirect(next, 302);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · FTC Scouting Dashboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="login-wrap">
      <div class="card login-card">
        <h1>FTC Scouting Dashboard</h1>
        <p class="sub">Sign in to see team rankings.</p>

        <form method="post" class="login-form">
          <input type="hidden" name="next" value={next} />

          <label class="field">
            <span>Username</span>
            <input name="username" value={username} autocomplete="username" required autofocus />
          </label>

          <label class="field">
            <span>Password</span>
            <input name="password" type="password" autocomplete="current-password" required />
          </label>

          {error && <p class="login-error" role="alert">{error}</p>}

          <button class="btn login-btn" type="submit">Sign in</button>
        </form>
      </div>
    </main>
  </body>
</html>
