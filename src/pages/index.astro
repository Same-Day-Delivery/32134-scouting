---
import { loadDashboard } from '../lib/load';
import '../styles/dashboard.css';

export const prerender = false;

const user = Astro.locals.user;
let boot: any = null;
let error: string | null = null;

// Opening the site reads the form responses, recalculates every team's points,
// and writes the results back to the Airtable "Points" table.
try {
  boot = await loadDashboard();
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FTC Scouting Dashboard</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <div>
          <h1>FTC Scouting Dashboard</h1>
          <p class="sub">
            Team rankings from the scouting form. Category scores are averaged per team, so a blank
            answer never drags anyone down.
          </p>
        </div>
        <div class="masthead-actions">
          {!error && (
            <>
              <span id="fetched" class="sub"></span>
              <button id="refresh" class="btn" type="button">Refresh</button>
            </>
          )}
          {user?.isAdmin && <a class="btn" href="/admin">Accounts</a>}
          <span class="whoami">{user?.username}</span>
          <form method="post" action="/logout" class="logout">
            <button class="btn btn-quiet" type="submit">Sign out</button>
          </form>
        </div>
      </header>

      {error ? (
        <div class="banner">
          <strong>Could not load the Airtable data.</strong>
          <div style="margin-top:6px">{error}</div>
        </div>
      ) : (
        <>
          <div id="sync-banner"></div>
          <div id="tiles" class="tiles"></div>

          <div class="tabs" role="tablist">
            <button class="tab" role="tab" data-tab="leaderboard" aria-selected="true">Leaderboard</button>
            <button class="tab" role="tab" data-tab="categories" aria-selected="false">Categories</button>
            <button class="tab" role="tab" data-tab="scoring" aria-selected="false">Scoring</button>
            <button class="tab" role="tab" data-tab="team" aria-selected="false">Team</button>
          </div>

          <section class="panel" data-tab="leaderboard" role="tabpanel">
            <div class="card">
              <div class="card-head">
                <h2 class="card-title">Ranked by total average points</h2>
              </div>
              <p class="card-sub">
                Each bar stacks a team's average points per category. Click a team name to open its
                entries; click a legend entry to drop that category from the stack.
              </p>
              <div id="leaderboard"></div>
            </div>
          </section>

          <section class="panel" data-tab="categories" role="tabpanel" hidden>
            <div id="facets" class="facets"></div>
          </section>

          <section class="panel" data-tab="scoring" role="tabpanel" hidden>
            <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap">
              <div>
                <h2 class="card-title">Point values</h2>
                <p class="card-sub" style="margin:4px 0 0">
                  Edits apply to every ranking immediately and are saved to the local SQLite database
                  (<code>data/scouting.db</code>). Reload the page to write the recalculated totals
                  back to the Airtable <code>Points</code> table.
                </p>
              </div>
              <div style="display:flex;gap:10px;align-items:center">
                <span id="save-state" class="save-state"></span>
                <button id="reset" class="btn" type="button">Reset to defaults</button>
              </div>
            </div>
            <div id="scoring" class="score-grid"></div>
          </section>

          <section class="panel" data-tab="team" role="tabpanel" hidden>
            <div class="team-picker">
              <label for="team-select" class="sub">Team</label>
              <select id="team-select"></select>
            </div>
            <div id="team-detail"></div>
          </section>

          <div id="tip" role="tooltip"></div>
          <script id="bootstrap" type="application/json" set:html={JSON.stringify(boot)}></script>
          <script src="../scripts/dashboard.ts"></script>
        </>
      )}
    </div>
  </body>
</html>
